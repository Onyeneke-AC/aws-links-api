# Copy to .env for local runs: `node --env-file=.env src/server.js`
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# Standard libpq variables, read directly by node-postgres.
# In AWS, PGUSER/PGPASSWORD are injected by ECS from Secrets Manager.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=links
PGUSER=links
PGPASSWORD=links-local-only
PGSSLMODE=disable
