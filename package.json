{
  "name": "links-api",
  "version": "1.0.0",
  "description": "Tiny URL shortener API, shipped to AWS ECS Fargate",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down -v"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  }
}
